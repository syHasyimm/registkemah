# npm run setup creates private local values in .env.local.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Leave blank for automatic Docker setup, or supply your own connection string.
DATABASE_URL=
# Optional direct connection for migrations when DATABASE_URL uses a pooler.
MIGRATION_DATABASE_URL=
# Optional fixed local database port. Setup chooses a free high port by default.
# POSTGRES_PORT=5433

# Optional Google OAuth; callback /api/auth/callback/google at BETTER_AUTH_URL.
GOOGLE_CLIENT_ID=726871811180-t7b10e05p35okmlg7hgq9juf4gdk4183.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=lsmvikzkbtixnona
# SMTP: npm run email:dev prepares a local Mailpit inbox without external delivery.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Keep private files on persistent storage, never in public/.
PRIVATE_STORAGE_DIR=
